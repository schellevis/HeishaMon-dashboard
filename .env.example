# Copy to .env and fill in. Never commit .env.

# Required: hostname of the MQTT broker HeishaMon publishes to.
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# 1, true or yes (case-insensitive) = on; anything else = off
MQTT_TLS=0
# Optional PEM CA bundle for verifying the broker when MQTT_TLS is on (the file must exist); empty = system CAs
MQTT_CA_FILE=
# 1-128 bytes, "/"-separated non-empty segments, no leading/trailing "/", no +, # or NUL, not starting with $
MQTT_BASE_TOPIC=panasonic_heat_pump

# Writable directory for the SQLite database
DATA_DIR=/data
# Integer 10-86400
FLUSH_INTERVAL_SECONDS=900
# Integer >= 1000
BUFFER_MAX_ENTRIES=200000
# Integer >= 16777216 (16 MiB); default is 256 MiB
BUFFER_MAX_BYTES=268435456
# Integer 100-100000
AUDIT_BUFFER_MAX=10000
# Integer >= 1: max publish attempts per command name per window (retries count); over it -> 429
COMMAND_RATE_MAX=6
# Integer >= 1: sliding window in seconds
COMMAND_RATE_WINDOW_S=3600
# Integer >= 1; empty = keep raw samples forever
RAW_RETENTION_DAYS=

HTTP_PORT=8000
# IANA timezone name
TZ=UTC

# Comma-separated origins (scheme://host[:port]) at which users reach the dashboard; empty = derive from Host
PUBLIC_ORIGINS=
# Comma-separated additional origins allowed to call the API cross-origin (embedding)
ALLOWED_ORIGINS=
